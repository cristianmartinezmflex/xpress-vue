{
  "title": "Cloud Identity Sync (Demo)",
  "customSyncTables": [
    "USERS",
    "BADGES",
    "GROUPS",
    "GROUPS_USERS",
    "COMPANIES"
  ],
  "tabs": [
    {
      "title": "Settings",
      "sections": [
        {
          "title": "Connection",
          "columns": [
            {
              "controls": [
                {
                  "id": "api_url",
                  "type": "text",
                  "title": "API URL",
                  "default": "https://api.cloud-identity.example.com"
                },
                {
                  "id": "tenant_id",
                  "type": "text",
                  "title": "Tenant ID",
                  "default": ""
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "client_id",
                  "type": "text",
                  "title": "Client ID",
                  "default": ""
                },
                {
                  "id": "client_secret",
                  "type": "password",
                  "title": "Client Secret",
                  "default": ""
                }
              ]
            }
          ]
        },
        {
          "title": "Options",
          "columns": [
            {
              "controls": [
                {
                  "id": "sync_enabled",
                  "type": "boolean",
                  "title": "Enable automatic sync",
                  "default": true
                },
                {
                  "id": "sync_interval",
                  "type": "number_spinner",
                  "title": "Sync interval (minutes)",
                  "default": 60,
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 5,
                      "max": 1440,
                      "error": "5â€“1440 min"
                    }
                  ]
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "environment",
                  "type": "select",
                  "title": "Environment",
                  "default": "prod",
                  "options": [
                    {
                      "id": "prod",
                      "name": "Production"
                    },
                    {
                      "id": "stage",
                      "name": "Staging"
                    },
                    {
                      "id": "dev",
                      "name": "Development"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Enable â†’ Tab",
      "sections": [
        {
          "title": "Enable on Tab â€” tab stays visible but becomes non-clickable when disabled",
          "columns": [
            {
              "controls": [
                {
                  "id": "enable_tab_demo",
                  "type": "boolean",
                  "title": "Enable the 'Disabled Tab' tab",
                  "default": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Disabled Tab",
      "enable": "enable_tab_demo == true",
      "sections": [
        {
          "title": "This tab is enabled because enable_tab_demo == true",
          "columns": [
            {
              "controls": [
                {
                  "id": "conditional_tab_field",
                  "type": "text",
                  "title": "Sample field",
                  "default": "This tab was disabled â€” toggle the switch to enable it"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Display â†’ Tab",
      "sections": [
        {
          "title": "Display on Tab â€” tab is completely hidden when display is false",
          "columns": [
            {
              "controls": [
                {
                  "id": "show_tab_demo",
                  "type": "boolean",
                  "title": "Show the 'Hidden Tab' tab",
                  "default": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Hidden Tab",
      "display": "show_tab_demo == true",
      "sections": [
        {
          "title": "This tab is visible because show_tab_demo == true",
          "columns": [
            {
              "controls": [
                {
                  "id": "hidden_tab_field",
                  "type": "text",
                  "title": "Sample field",
                  "default": "This tab was hidden â€” toggle the switch to show it"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Enable â†’ Section & Field",
      "sections": [
        {
          "title": "Enable on Section â€” enables or disables the section below",
          "columns": [
            {
              "controls": [
                {
                  "id": "enable_section_demo",
                  "type": "boolean",
                  "title": "Enable the 'Section controlled by enable'",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Section controlled by enable (enable: \"enable_section_demo == true\")",
          "enable": "enable_section_demo == true",
          "columns": [
            {
              "controls": [
                {
                  "id": "section_enable_field_1",
                  "type": "text",
                  "title": "Field A",
                  "default": "Interactive only when the section is enabled"
                },
                {
                  "id": "section_enable_field_2",
                  "type": "number_spinner",
                  "title": "Field B",
                  "default": 42,
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 0,
                      "max": 9999,
                      "error": "0â€“9999"
                    }
                  ]
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "section_enable_field_3",
                  "type": "boolean",
                  "title": "Field C (boolean)",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Enable on Field â€” enables or disables individual fields",
          "columns": [
            {
              "controls": [
                {
                  "id": "enable_fields_demo",
                  "type": "boolean",
                  "title": "Enable the fields below",
                  "default": false
                },
                {
                  "id": "field_enable_text",
                  "type": "text",
                  "title": "Text field (enable: \"enable_fields_demo == true\")",
                  "default": "",
                  "enable": "enable_fields_demo == true"
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "field_enable_spinner",
                  "type": "number_spinner",
                  "title": "Number field (enable: \"enable_fields_demo == true\")",
                  "default": 100,
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 1,
                      "max": 1000,
                      "error": "1â€“1000"
                    }
                  ],
                  "enable": "enable_fields_demo == true"
                },
                {
                  "id": "field_enable_select",
                  "type": "select",
                  "title": "Select (enable: \"enable_fields_demo == true\")",
                  "default": "a",
                  "enable": "enable_fields_demo == true",
                  "options": [
                    {
                      "id": "a",
                      "name": "Option A"
                    },
                    {
                      "id": "b",
                      "name": "Option B"
                    },
                    {
                      "id": "c",
                      "name": "Option C"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Display â†’ Section & Field",
      "sections": [
        {
          "title": "Display on Section â€” shows or hides the section below",
          "columns": [
            {
              "controls": [
                {
                  "id": "show_section_demo",
                  "type": "boolean",
                  "title": "Show the 'Section controlled by display'",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Section controlled by display (display: \"show_section_demo == true\")",
          "display": "show_section_demo == true",
          "columns": [
            {
              "controls": [
                {
                  "id": "section_display_field_1",
                  "type": "text",
                  "title": "Field A",
                  "default": "Only visible when show_section_demo is true"
                },
                {
                  "id": "section_display_field_2",
                  "type": "boolean",
                  "title": "Field B (boolean)",
                  "default": false
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "section_display_field_3",
                  "type": "password",
                  "title": "Field C (password)",
                  "default": ""
                }
              ]
            }
          ]
        },
        {
          "title": "Display on Field â€” shows or hides individual fields",
          "columns": [
            {
              "controls": [
                {
                  "id": "show_fields_demo",
                  "type": "boolean",
                  "title": "Show the fields below",
                  "default": false
                },
                {
                  "id": "field_display_text",
                  "type": "text",
                  "title": "Text field (display: \"show_fields_demo == true\")",
                  "default": "",
                  "display": "show_fields_demo == true"
                },
                {
                  "id": "field_display_select",
                  "type": "select",
                  "title": "Select (display: \"show_fields_demo == true\")",
                  "default": "x",
                  "display": "show_fields_demo == true",
                  "options": [
                    {
                      "id": "x",
                      "name": "Option X"
                    },
                    {
                      "id": "y",
                      "name": "Option Y"
                    }
                  ]
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "field_display_spinner",
                  "type": "number_spinner",
                  "title": "Number (display: \"show_fields_demo == true\")",
                  "default": 0,
                  "display": "show_fields_demo == true",
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 0,
                      "max": 999,
                      "error": "0â€“999"
                    }
                  ]
                },
                {
                  "id": "field_display_bool",
                  "type": "boolean",
                  "title": "Boolean (display: \"show_fields_demo == true\")",
                  "default": false,
                  "display": "show_fields_demo == true"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "2 Columns",
      "sections": [
        {
          "title": "Enable on Column â€” left column disabled, right stays active",
          "columns": [
            {
              "enable": "enable_col_demo == true",
              "controls": [
                {
                  "id": "col_enable_text",
                  "type": "text",
                  "title": "Text field (in left column)",
                  "default": ""
                },
                {
                  "id": "col_enable_number",
                  "type": "number",
                  "title": "Number field (in left column)",
                  "default": 0
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "enable_col_demo",
                  "type": "boolean",
                  "title": "Enable the left column",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Display on Column â€” left column hidden, right stays visible",
          "columns": [
            {
              "display": "show_col_demo == true",
              "controls": [
                {
                  "id": "col_display_text",
                  "type": "text",
                  "title": "Text field (in left column)",
                  "default": "Now you see me!"
                },
                {
                  "id": "col_display_select",
                  "type": "select",
                  "title": "Select (in left column)",
                  "default": "a",
                  "options": [
                    {
                      "id": "a",
                      "name": "Option A"
                    },
                    {
                      "id": "b",
                      "name": "Option B"
                    }
                  ]
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "show_col_demo",
                  "type": "boolean",
                  "title": "Show the left column",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "2-column layout â€” all control types",
          "columns": [
            {
              "controls": [
                {
                  "id": "col2_text",
                  "type": "text",
                  "title": "Text",
                  "default": "sample text value"
                },
                {
                  "id": "col2_password",
                  "type": "password",
                  "title": "Password",
                  "default": ""
                },
                {
                  "id": "col2_number",
                  "type": "number",
                  "title": "Number",
                  "default": 80
                },
                {
                  "id": "col2_spinner",
                  "type": "number_spinner",
                  "title": "Spinner",
                  "default": 500,
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 1,
                      "max": 9999,
                      "error": "1â€“9999"
                    }
                  ]
                },
                {
                  "id": "col2_boolean",
                  "type": "boolean",
                  "title": "Boolean",
                  "default": true
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "col2_select",
                  "type": "select",
                  "title": "Select",
                  "default": "1",
                  "options": [
                    {
                      "id": "1",
                      "name": "Option 1"
                    },
                    {
                      "id": "2",
                      "name": "Option 2"
                    },
                    {
                      "id": "3",
                      "name": "Option 3"
                    }
                  ]
                },
                {
                  "id": "col2_radio",
                  "type": "radio",
                  "title": "Radio",
                  "default": "alpha",
                  "options": [
                    {
                      "id": "alpha",
                      "name": "Alpha"
                    },
                    {
                      "id": "beta",
                      "name": "Beta"
                    },
                    {
                      "id": "gamma",
                      "name": "Gamma"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Key-Value â€” field mapping",
          "columns": [
            {
              "controls": [
                {
                  "id": "demo_mappings",
                  "type": "customFields",
                  "title": "",
                  "key_title": "Source Field",
                  "key_header": "Source",
                  "value_title": "Target Field",
                  "value_header": "Target",
                  "default": [
                    {
                      "key": "firstName",
                      "value": "first_name"
                    },
                    {
                      "key": "lastName",
                      "value": "last_name"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
