{
  "title": "RS2 REST Data Manager",
  "tabs": [
    {
      "title": "General",
      "sections": [
        {
          "title": "Server",
          "columns": [
            {
              "controls": [
                {
                  "id": "serverip",
                  "type": "text",
                  "title": "Server IP / Hostname",
                  "default": "localhost",
                  "validations": [
                    {
                      "type": "required",
                      "error": "Server is required"
                    }
                  ]
                },
                {
                  "id": "port",
                  "type": "text",
                  "title": "API Port",
                  "default": "7777"
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "timezoneinfo",
                  "type": "select",
                  "title": "Server Timezone",
                  "default": "US Mountain Standard Time",
                  "options": [
                    {
                      "id": "Eastern Standard Time",
                      "name": "Eastern Standard Time"
                    },
                    {
                      "id": "Central Standard Time",
                      "name": "Central Standard Time"
                    },
                    {
                      "id": "US Mountain Standard Time",
                      "name": "US Mountain Standard Time"
                    },
                    {
                      "id": "Mountain Standard Time",
                      "name": "Mountain Standard Time"
                    },
                    {
                      "id": "Pacific Standard Time",
                      "name": "Pacific Standard Time"
                    },
                    {
                      "id": "Alaskan Standard Time",
                      "name": "Alaskan Standard Time"
                    },
                    {
                      "id": "Hawaiian Standard Time",
                      "name": "Hawaiian Standard Time"
                    },
                    {
                      "id": "GMT Standard Time",
                      "name": "GMT Standard Time"
                    },
                    {
                      "id": "UTC",
                      "name": "UTC"
                    },
                    {
                      "id": "Central European Standard Time",
                      "name": "Central European Standard Time"
                    },
                    {
                      "id": "W. Europe Standard Time",
                      "name": "W. Europe Standard Time"
                    },
                    {
                      "id": "AUS Eastern Standard Time",
                      "name": "AUS Eastern Standard Time"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "RS2 Credentials",
          "columns": [
            {
              "controls": [
                {
                  "id": "username",
                  "type": "text",
                  "title": "Username",
                  "default": ""
                },
                {
                  "id": "password",
                  "type": "password",
                  "title": "Password",
                  "default": ""
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "api_token",
                  "type": "password",
                  "title": "API Token",
                  "default": "19137A2256583B065DD336D02BD46F27"
                },
                {
                  "id": "enable_data_protect",
                  "type": "boolean",
                  "title": "Enable Data Protect",
                  "default": true
                }
              ]
            }
          ]
        },
        {
          "title": "Options",
          "columns": [
            {
              "controls": [
                {
                  "id": "selected_site",
                  "type": "select_dynamic",
                  "title": "Select Site",
                  "loadFrom": "sites",
                  "default": "-1"
                },
                {
                  "id": "pagesize",
                  "type": "number_spinner",
                  "title": "Page Size",
                  "default": 100,
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 1,
                      "max": 10000,
                      "error": "Must be between 1 and 10000"
                    }
                  ]
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "active_cardholders_only",
                  "type": "boolean",
                  "title": "Active Cardholders Only",
                  "default": false
                },
                {
                  "id": "create_doors",
                  "type": "boolean",
                  "title": "Create Doors for Readers",
                  "default": true
                },
                {
                  "id": "validate_ssl",
                  "type": "boolean",
                  "title": "Validate SSL Cert",
                  "default": false
                },
                {
                  "id": "verbose_api_data",
                  "type": "boolean",
                  "title": "Verbose API Data",
                  "default": false
                },
                {
                  "id": "curl_debugging",
                  "type": "boolean",
                  "title": "Enable Curl Debugging",
                  "default": false
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Site Timezones",
      "sections": [
        {
          "title": "Site Timezone Overrides",
          "columns": [
            {
              "controls": [
                {
                  "id": "site_timezones",
                  "type": "site_timezones",
                  "title": "Site Timezones"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Custom Mappings",
      "sections": [
        {
          "title": "Custom Field Mapping",
          "columns": [
            {
              "controls": [
                {
                  "id": "custom_fields_users",
                  "type": "customFields",
                  "title": "Custom User Field Mapping (RS2 Field → XPE Field)",
                  "key_title": "Source Columns",
                  "key_header": "Source Columns",
                  "value_title": "Destination Columns",
                  "value_header": "Destination Columns",
                  "entity": "Users",
                  "loadFrom": "user-fields"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
