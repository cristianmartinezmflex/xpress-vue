{
  "title": "Genetec Data Manager",
  "tabs": [
    {
      "title": "General",
      "sections": [
        {
          "title": "SDK Connection",
          "columns": [
            {
              "controls": [
                {
                  "id": "server_ip",
                  "type": "text",
                  "title": "Server",
                  "default": "localhost",
                  "validations": [
                    {
                      "type": "required",
                      "error": "Server is required"
                    }
                  ]
                },
                {
                  "id": "login",
                  "type": "text",
                  "title": "Username",
                  "default": "admin"
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "password",
                  "type": "password",
                  "title": "Password",
                  "default": ""
                }
              ]
            }
          ]
        },
        {
          "title": "Data Settings",
          "columns": [
            {
              "controls": [
                {
                  "id": "related_data",
                  "type": "boolean",
                  "title": "Download Related Data",
                  "default": true
                },
                {
                  "id": "cardholder_events",
                  "type": "boolean",
                  "title": "Cardholder Software Events",
                  "default": true
                },
                {
                  "id": "credential_events",
                  "type": "boolean",
                  "title": "Credential Software Events",
                  "default": true
                },
                {
                  "id": "access_rule_events",
                  "type": "boolean",
                  "title": "Access Rule Software Events",
                  "default": true
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "use_raw_data",
                  "type": "boolean",
                  "title": "Use Raw Data",
                  "default": false
                },
                {
                  "id": "send_wiegand_on_searched",
                  "type": "boolean",
                  "title": "Send Wiegand on Searched",
                  "default": false
                },
                {
                  "id": "page_size",
                  "type": "number_spinner",
                  "title": "Page Size",
                  "default": 10000,
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 1,
                      "max": 100000,
                      "error": "Must be between 1 and 100000"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Occupancy Settings",
          "columns": [
            {
              "controls": [
                {
                  "id": "update_cardholder_occupancy",
                  "type": "boolean",
                  "title": "Update Cardholder Occupancy",
                  "default": true
                },
                {
                  "id": "min_hours_of_activities_to_pull",
                  "type": "number_spinner",
                  "title": "Min Hours of Activities to Pull",
                  "default": 4
                }
              ]
            }
          ]
        },
        {
          "title": "Custom Card Format",
          "columns": [
            {
              "controls": [
                {
                  "id": "custom_card_format",
                  "type": "boolean",
                  "title": "Use Custom Card Format",
                  "default": false
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "card_num_start_bit",
                  "type": "number_spinner",
                  "title": "Card Number Start Bit",
                  "default": 0
                },
                {
                  "id": "card_num_bit_length",
                  "type": "number_spinner",
                  "title": "Card Number Bit Length",
                  "default": 0
                },
                {
                  "id": "fc_start_bit",
                  "type": "number_spinner",
                  "title": "Facility Code Start Bit",
                  "default": 0
                },
                {
                  "id": "fc_bit_length",
                  "type": "number_spinner",
                  "title": "Facility Code Bit Length",
                  "default": 0
                }
              ]
            }
          ]
        },
        {
          "title": "",
          "columns": [
            {
              "controls": [
                {
                  "id": "customFields",
                  "type": "customFields",
                  "title": "",
                  "entity": "Users",
                  "loadFrom": "/api/data-managers/{dmId}/dm-data?type=custom-fields-users",
                  "destinationLoadFrom": "/api/shared/entity-fields-users"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "CloudLink",
      "sections": [
        {
          "title": "CloudLink Devices",
          "columns": [
            {
              "controls": [
                {
                  "id": "rio_list",
                  "type": "table",
                  "title": "CloudLink Devices",
                  "fields": [
                    {
                      "id": "Name",
                      "type": "text",
                      "title": "Device Name",
                      "isKey": true
                    },
                    {
                      "id": "Server",
                      "type": "text",
                      "title": "Device IP"
                    },
                    {
                      "id": "Username",
                      "type": "text",
                      "title": "RIO User"
                    },
                    {
                      "id": "Password",
                      "type": "password",
                      "title": "RIO Password"
                    },
                    {
                      "id": "AcceptUntrustedCert",
                      "type": "boolean",
                      "title": "Accept Untrusted Certificate"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Global RIO Settings",
          "columns": [
            {
              "controls": [
                {
                  "id": "rio_enabled",
                  "type": "boolean",
                  "title": "Enable CloudLink (RIO)",
                  "default": true
                },
                {
                  "id": "rio_reader_timeout",
                  "type": "number_spinner",
                  "title": "RIO Reader Timeout (ms)",
                  "default": 3000
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Custom",
      "sections": [
        {
          "title": "Custom Events",
          "columns": [
            {
              "controls": [
                {
                  "id": "cardholder_event_name",
                  "type": "text",
                  "title": "Custom Cardholder Granted",
                  "default": ""
                },
                {
                  "id": "cardholder_event_name_denied",
                  "type": "text",
                  "title": "Custom Cardholder Denied",
                  "default": ""
                },
                {
                  "id": "credential_event_name",
                  "type": "text",
                  "title": "Custom Credential Granted",
                  "default": ""
                },
                {
                  "id": "credential_event_name_denied",
                  "type": "text",
                  "title": "Custom Credential Denied",
                  "default": ""
                },
                {
                  "id": "zone_event_name",
                  "type": "text",
                  "title": "Custom Area Event",
                  "default": ""
                }
              ]
            }
          ]
        },
        {
          "title": "Credential Custom Fields",
          "columns": [
            {
              "controls": [
                {
                  "id": "custom_credential_field_1",
                  "type": "text",
                  "title": "Credential Field 1",
                  "default": ""
                },
                {
                  "id": "custom_credential_field_2",
                  "type": "text",
                  "title": "Credential Field 2",
                  "default": ""
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "custom_credential_field_3",
                  "type": "text",
                  "title": "Credential Field 3",
                  "default": ""
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
