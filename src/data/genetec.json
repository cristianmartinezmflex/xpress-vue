{
  "title": "Genetec Data Manager",
  "tabs": [
    {
      "title": "General",
      "sections": [
        {
          "title": "SDK Connection",
          "columns": [
            {
              "controls": [
                {
                  "id": "server_ip",
                  "type": "text",
                  "title": "Server",
                  "default": "localhost",
                  "validations": [
                    {
                      "type": "required",
                      "error": "Server is required"
                    }
                  ]
                },
                {
                  "id": "login",
                  "type": "text",
                  "title": "Username",
                  "default": "admin"
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "password",
                  "type": "password",
                  "title": "Password",
                  "default": ""
                }
              ]
            }
          ]
        },
        {
          "title": "Data Settings",
          "columns": [
            {
              "controls": [
                {
                  "id": "related_data",
                  "type": "boolean",
                  "title": "Download Related Data",
                  "default": true
                },
                {
                  "id": "cardholder_events",
                  "type": "boolean",
                  "title": "Cardholder Software Events",
                  "default": true
                },
                {
                  "id": "credential_events",
                  "type": "boolean",
                  "title": "Credential Software Events",
                  "default": true
                },
                {
                  "id": "access_rule_events",
                  "type": "boolean",
                  "title": "Access Rule Software Events",
                  "default": true
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "use_raw_data",
                  "type": "boolean",
                  "title": "Use Raw Badge Data from Genetec",
                  "default": false
                },
                {
                  "id": "send_wiegand_on_searched",
                  "type": "boolean",
                  "title": "Send Wiegand for Searched Cardholder",
                  "default": false
                },
                {
                  "id": "page_size",
                  "type": "number_spinner",
                  "title": "SDK Page Size",
                  "default": 10000,
                  "validations": [
                    {
                      "type": "min_max",
                      "min": 1,
                      "max": 100000,
                      "error": "Must be between 1 and 100000"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Occupancy Settings",
          "columns": [
            {
              "controls": [
                {
                  "id": "update_cardholder_occupancy",
                  "type": "boolean",
                  "title": "Update Cardholder Occupancy",
                  "default": true
                },
                {
                  "id": "min_hours_of_activities_to_pull",
                  "type": "number_spinner",
                  "title": "Download Activity # Hours",
                  "default": 4
                }
              ]
            }
          ]
        },
        {
          "title": "Custom Card Format",
          "columns": [
            {
              "controls": [
                {
                  "id": "custom_card_format",
                  "type": "boolean",
                  "title": "Use Custom Card Format",
                  "default": false
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "card_num_start_bit",
                  "type": "number_spinner",
                  "title": "Card Number Start Bit",
                  "default": 0
                },
                {
                  "id": "card_num_bit_length",
                  "type": "number_spinner",
                  "title": "Card Number Bit Length",
                  "default": 0
                },
                {
                  "id": "fc_start_bit",
                  "type": "number_spinner",
                  "title": "Facility Code Start Bit",
                  "default": 0
                },
                {
                  "id": "fc_bit_length",
                  "type": "number_spinner",
                  "title": "Facility Code Bit Length",
                  "default": 0
                }
              ]
            }
          ]
        },
        {
          "title": "",
          "columns": [
            {
              "controls": [
                {
                  "id": "customFields",
                  "type": "keyvalue",
                  "title": "",
                  "key_title": "Source Columns",
                  "key_header": "Source Field",
                  "value_title": "Destination Columns",
                  "value_header": "XPressEntry Field",
                  "default": []
                },
                {
                  "id": "btn_load_custom_fields",
                  "type": "button_bar",
                  "buttons": [
                    {
                      "id": "btn_load_custom_fields",
                      "title": "Load Genetec Custom Fields",
                      "onClick": "genetec_loadCustomFields",
                      "tooltip": "Load available cardholder fields from Genetec for custom field mapping."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "CloudLink",
      "sections": [
        {
          "title": "CloudLink (RIO) Devices",
          "columns": [
            {
              "controls": [
                {
                  "id": "cloudlink_buttons",
                  "type": "button_bar",
                  "buttons": [
                    {
                      "id": "btn_sync_doors",
                      "title": "Sync Doors from Genetec",
                      "onClick": "genetec_syncDoors",
                      "enable": "rio_enabled == true",
                      "tooltip": "Synchronize door and reader data from the Genetec Security Center into XPressEntry."
                    }
                  ]
                },
                {
                  "id": "rio_list",
                  "type": "rio_devices",
                  "title": "CloudLink Devices",
                  "buttons": [
                    {
                      "id": "btn_ping_rio",
                      "title": "Ping",
                      "onClick": "genetec_pingRio",
                      "tooltip": "Test connectivity to this CloudLink (RIO) device."
                    },
                    {
                      "id": "btn_update_rio",
                      "title": "Update RIO Readers",
                      "onClick": "genetec_updateRio",
                      "tooltip": "Push the current reader/door configuration to this CloudLink (RIO) device."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Global RIO Settings",
          "columns": [
            {
              "controls": [
                {
                  "id": "rio_enabled",
                  "type": "boolean",
                  "title": "Enable RIO",
                  "default": true
                },
                {
                  "id": "rio_reader_timeout",
                  "type": "number_spinner",
                  "title": "RIO Reader Timeout (mins)",
                  "default": 3000
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Custom",
      "sections": [
        {
          "title": "Event Names",
          "columns": [
            {
              "controls": [
                {
                  "id": "cardholder_event_name",
                  "type": "text",
                  "title": "Cardholder Event Name",
                  "default": ""
                },
                {
                  "id": "cardholder_event_name_denied",
                  "type": "text",
                  "title": "Cardholder Denied Event Name",
                  "default": ""
                },
                {
                  "id": "credential_event_name",
                  "type": "text",
                  "title": "Credential Event Name",
                  "default": ""
                },
                {
                  "id": "credential_event_name_denied",
                  "type": "text",
                  "title": "Credential Denied Event Name",
                  "default": ""
                },
                {
                  "id": "zone_event_name",
                  "type": "text",
                  "title": "Zone / Area Event Name",
                  "default": ""
                }
              ]
            }
          ]
        },
        {
          "title": "Credential Custom Fields",
          "columns": [
            {
              "controls": [
                {
                  "id": "custom_credential_field_1",
                  "type": "text",
                  "title": "Custom Credential Field 1",
                  "default": ""
                },
                {
                  "id": "custom_credential_field_2",
                  "type": "text",
                  "title": "Custom Credential Field 2",
                  "default": ""
                }
              ]
            },
            {
              "controls": [
                {
                  "id": "custom_credential_field_3",
                  "type": "text",
                  "title": "Custom Credential Field 3",
                  "default": ""
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
